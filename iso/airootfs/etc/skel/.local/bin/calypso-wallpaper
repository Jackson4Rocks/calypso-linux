#!/bin/bash
set -euo pipefail

WALL="${1:-}"

if [[ -z "$WALL" ]]; then
  SEARCH_DIRS=(
    "$HOME/.local/share/calypso/wallpapers"
    "/usr/share/backgrounds/calypso/stock"
    "$HOME/Pictures/wallpapers"
  )

  FILES=""
  for dir in "${SEARCH_DIRS[@]}"; do
    if [[ -d "$dir" ]]; then
      while IFS= read -r file; do
        FILES+="$file"
        FILES+=$'\n'
      done < <(find "$dir" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.svg' \) 2>/dev/null)
    fi
  done

  WALL="$(printf "%s" "$FILES" | sed '/^$/d' | sort -u | fuzzel --dmenu --prompt='Wallpaper > ' | head -n1 || true)"
fi

if [[ -z "$WALL" ]]; then
  echo "No wallpaper selected."
  exit 0
fi

if [[ ! -f "$WALL" ]]; then
  echo "Wallpaper not found: $WALL" >&2
  exit 1
fi

mkdir -p "$HOME/.config/quickshell/aurora" "$HOME/.config/kitty" "$HOME/.config/fuzzel"

if command -v matugen >/dev/null 2>&1; then
  matugen image "$WALL" -m dark
fi

if command -v hyprpaper >/dev/null 2>&1; then
  hyprpaper preload "$WALL" >/dev/null 2>&1 || true
  while IFS= read -r monitor; do
    [[ -n "$monitor" ]] || continue
    hyprpaper wallpaper "$monitor,$WALL,cover" >/dev/null 2>&1 || true
  done < <(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)
fi

printf 'Calypso wallpaper set: %s\n' "$WALL"
