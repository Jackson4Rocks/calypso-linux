#!/bin/bash
set -u

# Calypso Linux curated wallpaper installer.
# All stock photo sources are intentionally limited to:
# https://files.enderman.ch/wallpapers/

TARGET="${1:-/usr/share/backgrounds/calypso/stock}"
mkdir -p "$TARGET"

download() {
    local url="$1"
    local out="$2"
    if [ -s "$TARGET/$out" ]; then
        printf 'Wallpaper already present: %s\n' "$out"
        return 0
    fi
    printf 'Wallpaper: %s\n' "$out"
    if curl -fL --retry 3 --connect-timeout 10 --max-time 120 -o "$TARGET/$out" "$url"; then
        chmod 0644 "$TARGET/$out"
    else
        rm -f "$TARGET/$out"
        printf 'Warning: could not download %s\n' "$out" >&2
    fi
}

while IFS= read -r wallpaper || [ -n "$wallpaper" ]; do
    case "$wallpaper" in
        ""|#*) continue ;;
    esac
    encoded="${wallpaper// /%20}"
    download "https://files.enderman.ch/wallpapers/${encoded}" "$wallpaper"
done < /usr/share/calypso/enderman-wallpapers.txt
