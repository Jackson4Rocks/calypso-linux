#!/usr/bin/env bash
set -euo pipefail

DEFAULT="$HOME/.local/share/calypso/CALYPSO-wallpaper.webp"
WALL="${1:-$DEFAULT}"

if [[ ! -f "$WALL" ]]; then
  printf 'Wallpaper not found: %s\n' "$WALL" >&2
  printf 'Usage: calypso-wallpaper /path/to/image\n' >&2
  exit 1
fi

command -v dms >/dev/null 2>&1 || {
  printf 'DankMaterialShell is not installed or not on PATH.\n' >&2
  exit 1
}

dms ipc call wallpaper set "$WALL"
printf 'Calypso wallpaper set: %s\n' "$WALL"
